# ExamPulse v2 Configuration (copy to backend/.env or run ./setup_infra.sh)

ENVIRONMENT=development
INSTANCE_ID=backend-1

# Database: PostgreSQL recommended for production (run ./setup_infra.sh), SQLite WAL for local dev
DATABASE_URL=postgresql+asyncpg://exampulse_user:exampulse_local_pass@127.0.0.1:5432/exampulse

# Redis / Valkey (100% free, open-source). Set ALLOW_FAKE_REDIS=false when real Redis is running.
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_FAKE_REDIS=false

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_a_strong_random_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
SECURE_COOKIES=false
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Set SEED_DEMO_DATA=false for a blank production database (admin account only)
SEED_DEMO_DATA=true
INITIAL_ADMIN_PASSWORD=admin123
