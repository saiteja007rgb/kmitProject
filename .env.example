# ExamPulse Environment Configuration

# Backend Instance Identifier
INSTANCE_ID=backend-1

# Database Configuration (PostgreSQL in Docker, or SQLite WAL locally)
DATABASE_URL=sqlite+aiosqlite:///./backend/exampulse.db
# For Docker PostgreSQL: postgresql+asyncpg://exampulse_user:secure_db_password@localhost:5432/exampulse

# Redis Configuration (Falls back gracefully to in-memory fake redis if offline)
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=exampulse_super_secret_hackathon_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

